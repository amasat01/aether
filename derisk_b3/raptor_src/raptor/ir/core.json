  "LANE_POSITION_KIND": "lane_position",
  "PLANE_EXTENT_KIND": "plane_extent",
  "DISPATCH_KIND": "dispatch",
  "NAMESPACE_SEP": "__",
  "FUSED_STEPS_PLANE": "fused_steps",
  "PARAM_CELL": "param_cell",
  "ROLE_ORDER": [
   "mutable",
   "out",
