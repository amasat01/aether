  "FACTOR_TAGS": [
   "lu_factor",
   "chol_factor",
   "eigh_factor",
   "qr_factor"
  ],
  "DISPATCH_POLICIES": [
   "predicated",
   "switch",
   "segmented",
   "auto"
  ],
  "POLICIES": [
   "auto",
   "compensated",
   "ordered"
  ],
  "SCATTER_POLICIES": [
   "auto",
   "compensated",
   "ordered",
   "plain",
   "or"
  ],
