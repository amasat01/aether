 "checks": {
  "node_base": {
   "params": [
    "cls",
    "ttype",
    "operands"
   ],
   "steps": [
    [
     "check",
     "not isinstance(ttype, TensorType)",
     "{name_of(cls)}: ttype must be a TensorType, got {ttype!r}"
    ],
    [
     "let",
     "bad",
     "first_not_node(operands)"
    ],
    [
     "check",
     "bad is not None",
     "{name_of(cls)}: operand {bad!r} is not a Node"
    ],
    [
     "check",
     "cut_in_loop(operands)",
     "a cut inside a `for` is not in this release (it would be one launch per iteration); hoist hawk.sum(x) out of the loop"
    ]
   ]
  },
  "refuse_factor_arms": {
   "params": [
    "what",
    "ttype"
   ],
   "steps": [
    [
     "check",
     "ttype.tag in FACTOR_TAGS",
     "{what}: the arms are {head(ttype.tag)} factorisations, which are read through lu_solve/cho_solve and the field reads, never selected between; select between the results (the solves, the determinant, the eigenvalues) instead"
    ]
   ]
  },
  "node_sink": {
   "params": [
    "kind",
    "role",
    "name",
    "value",
    "index",
    "ttype"
   ],
   "steps": [
    [
     "let",
     "tt",
     "coalesce(ttype, value.ttype)"
    ],
    [
     "let",
     "ops",
     "cat((value,), opt(index))"
    ],
    [
     "node",
     "tt",
     "ops"
    ],
    [
     "check",
     "role not in SINK_ROLES",
     "sink {name!r}: unknown sink role {role!r}, expected one of {SINK_ROLES}"
    ]
   ]
  }
 },
