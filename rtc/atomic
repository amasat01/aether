// NVRTC profile shim: NVRTC (parsed by __CUDACC_RTC__) has no host
// C++ standard library, so aether's payload headers reach <atomic> through
// this shim instead: the CCCL wheel's device-usable cuda::std::atomic,
// re-exported into ::std so aether's ordinary `std::` spellings resolve
// unchanged. Served only under NVRTC (payload name "rtc/atomic");
// nvcc and g++ TUs use the real system <atomic> and never see this file.
#include <cuda/std/atomic>
namespace std { using namespace cuda::std; }
